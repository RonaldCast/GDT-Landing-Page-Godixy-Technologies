# Public site URL used for canonical and hreflang links.
SITE_URL=https://godixy.com

# SMTP transport for the contact form. When SMTP_HOST is empty the form
# returns "mail unavailable" and the UI offers a mailto: fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_TO=hello@godixy.com
CONTACT_FROM="Godixy Website <no-reply@godixy.com>"

# Node standalone server
HOST=0.0.0.0
PORT=4321

# Behind Coolify's reverse proxy the contact action uses the first
# X-Forwarded-For hop when this is enabled (astro.config.mjs, src/actions/index.ts).
# Set the value only in Coolify. Do not commit secrets.
# TRUST_PROXY

# HSTS header in server.mjs. Enable only after TLS is confirmed on the proxy.
# ENABLE_HSTS
