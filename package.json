{
  "name": "godixy-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Godixy Technologies bilingual (EN/ES) corporate landing page.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node ./server.mjs",
    "start": "node ./server.mjs",
    "check": "astro check && vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@astrojs/node": "~11.1.9",
    "@astrojs/vue": "~7.1.2",
    "@fontsource-variable/inter": "^5.3.0",
    "animejs": "^4.5.0",
    "astro": "~7.3.8",
    "nodemailer": "^10.2.1",
    "three": "^0.186.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
