---
import type { Dictionary } from '@/shared/i18n/en';
import Button from '@/shared/ui/Button.astro';
import SectionHeader from '@/shared/ui/SectionHeader.astro';

interface Props {
  t: Dictionary['engagement'];
}

const { t } = Astro.props;
---

<section id="engagement" class="section" aria-labelledby="engagement-title">
  <div class="container">
    <SectionHeader id="engagement-title" label={t.label} title={t.title} intro={t.intro} />

    <ul class="models" data-reveal>
      {
        t.models.map((model, i) => (
          <li class="model" data-reveal-item>
            <span class="model__index" aria-hidden="true">
              0{i + 1}
            </span>
            <h3>{model.title}</h3>
            <p>{model.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="support" data-reveal>
      <div class="support__head" data-reveal-item>
        <h3>{t.supportTitle}</h3>
        <p>{t.supportIntro}</p>
      </div>
      <ul class="plans">
        {
          t.plans.map((plan, i) => (
            <li class:list={['plan', { 'plan--featured': i === 1 }]} data-reveal-item>
              <p class="plan__name">{plan.name}</p>
              <p class="plan__text">{plan.text}</p>
              <ul class="check-list">
                {plan.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
      <div class="support__foot">
        <p>{t.plansNote}</p>
        <Button href="#contact" variant="primary">{t.cta}</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .models {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  .model {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    transition:
      border-color var(--duration-base),
      transform var(--duration-base) var(--ease-out);
  }

  .model:hover {
    border-color: var(--color-teal);
    transform: translateY(-2px);
  }

  .model__index {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-teal-text);
  }

  .model h3 {
    font-size: 1.125rem;
  }

  .model p {
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  .support {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-7);
    padding: var(--space-7) var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-soft-teal);
  }

  .support__head {
    display: grid;
    gap: var(--space-2);
    max-width: 640px;
  }

  .support__head p {
    color: var(--color-muted);
  }

  .plans {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .plan {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-6) var(--space-5);
    border-radius: var(--radius-panel);
    background: var(--color-white);
    border: 1px solid var(--color-border);
  }

  .plan--featured {
    border-color: var(--color-navy);
    box-shadow: var(--shadow-md);
  }

  .plan__name {
    font-size: var(--text-h3);
    font-weight: 700;
  }

  .plan__text {
    color: var(--color-muted);
  }

  .support__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .support__foot p {
    max-width: 560px;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  @media (max-width: 1024px) {
    .models {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 760px) {
    .models,
    .plans {
      grid-template-columns: 1fr;
    }

    .support {
      padding: var(--space-6) var(--space-5);
    }
  }
</style>
