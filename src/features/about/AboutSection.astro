---
import type { Dictionary } from '@/shared/i18n/en';
import SectionHeader from '@/shared/ui/SectionHeader.astro';

interface Props {
  t: Dictionary['about'];
}

const { t } = Astro.props;
---

<section id="about" class="section section--surface" aria-labelledby="about-title">
  <div class="container">
    <SectionHeader id="about-title" label={t.label} title={t.title} />

    <div class="statements" data-reveal>
      <article class="statement" data-reveal-item>
        <h3>{t.missionTitle}</h3>
        <p>{t.mission}</p>
      </article>
      <article class="statement statement--vision" data-reveal-item>
        <h3>{t.visionTitle}</h3>
        <p>{t.vision}</p>
      </article>
    </div>

    <h3 class="values__title" data-reveal>{t.valuesTitle}</h3>
    <ol class="values" data-reveal>
      {
        t.values.map((value, i) => (
          <li class="value" data-reveal-item>
            <span class="value__index" aria-hidden="true">
              0{i + 1}
            </span>
            <h4>{value.title}</h4>
            <blockquote>{value.quote}</blockquote>
            <p>{value.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .statements {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }

  .statement {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding: var(--space-7) var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    border: 1px solid var(--color-border);
  }

  .statement h3 {
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-teal-text);
  }

  .statement p {
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--color-navy);
  }

  .statement--vision {
    background: var(--color-navy);
    border-color: var(--color-navy);
  }

  .statement--vision h3 {
    color: var(--color-teal);
  }

  .statement--vision p {
    color: var(--color-white);
  }

  .values__title {
    margin: var(--space-8) 0 var(--space-5);
  }

  .values {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .value {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-6);
    border-radius: var(--radius-panel);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--color-teal);
  }

  .value__index {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-teal-text);
  }

  .value h4 {
    font-size: var(--text-h3);
    font-weight: 700;
  }

  blockquote {
    margin: 0;
    font-weight: 600;
    color: var(--color-navy);
  }

  .value p {
    color: var(--color-muted);
  }

  @media (max-width: 860px) {
    .statements,
    .values {
      grid-template-columns: 1fr;
    }

    .statement {
      padding: var(--space-6) var(--space-5);
    }
  }
</style>
