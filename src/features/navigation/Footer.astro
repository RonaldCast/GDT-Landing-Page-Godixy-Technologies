---
import type { Lang } from '@/shared/i18n/config';
import type { Dictionary } from '@/shared/i18n/en';
import Icon from '@/shared/ui/Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.vue';
import { buildNavItems } from './nav-items';

interface Props {
  lang: Lang;
  t: Dictionary;
}

const { lang, t } = Astro.props;
const items = buildNavItems(t.nav);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <img src="/logo-on-dark.png" alt="Godixy Technologies" width="160" height="55" loading="lazy" />
      <p>{t.footer.tagline}</p>
    </div>

    <nav aria-label={t.footer.navTitle}>
      <h2 class="footer__title">{t.footer.navTitle}</h2>
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li><a href="#contact">{t.nav.cta}</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="footer__title">{t.footer.contactTitle}</h2>
      <a class="footer__email" href={`mailto:${t.contact.email}`}>
        <Icon name="mail" size={18} />
        {t.contact.email}
      </a>
      <div class="footer__lang">
        <LanguageSwitcher client:visible current={lang} label={t.nav.language} tone="dark" />
      </div>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>© {year} {t.footer.legalName}. {t.footer.rights}</p>
    <div class="footer__legal">
      <a href={`/${lang}/privacy/`}>{t.footer.privacy}</a>
      <a href="#main">{t.footer.backToTop}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-navy);
    color: var(--color-on-navy-muted);
    padding-top: var(--space-8);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: var(--space-7);
    padding-bottom: var(--space-7);
  }

  .footer__brand {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    max-width: 360px;
  }

  .footer__brand img {
    width: 140px;
    height: auto;
    border-radius: 7px;
  }

  .footer__title {
    margin-bottom: var(--space-4);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-teal);
  }

  .footer ul {
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }

  .footer a {
    color: var(--color-white);
    text-decoration: none;
  }

  .footer a:hover {
    text-decoration: underline;
  }

  .footer__email {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
  }

  .footer__lang {
    margin-top: var(--space-5);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: 0.875rem;
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  .footer :focus-visible {
    box-shadow: 0 0 0 3px var(--color-teal);
  }

  @media (max-width: 860px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
