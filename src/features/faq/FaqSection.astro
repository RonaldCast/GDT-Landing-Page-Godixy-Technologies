---
import type { Dictionary } from '@/shared/i18n/en';
import SectionHeader from '@/shared/ui/SectionHeader.astro';

interface Props {
  t: Dictionary['faq'];
}

const { t } = Astro.props;
---

<section id="faq" class="section" aria-labelledby="faq-title">
  <div class="container faq">
    <SectionHeader id="faq-title" label={t.label} title={t.title} />
    <div class="faq__list" data-reveal>
      {
        t.items.map((item, i) => (
          <details class="faq__item" name="faq" open={i === 0} data-reveal-item>
            <summary>
              <span>{item.q}</span>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: var(--space-7);
    align-items: start;
  }

  .faq__list {
    display: grid;
    gap: var(--space-3);
  }

  .faq__item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    background: var(--color-white);
    transition: border-color var(--duration-base);
  }

  .faq__item[open] {
    border-color: var(--color-teal);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5);
    font-weight: 600;
    font-size: 1.0625rem;
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius-panel);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-soft-teal);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 2px;
    margin: -1px 0 0 -6px;
    border-radius: 2px;
    background: var(--color-teal-text);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .faq__icon::after {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__icon::after {
    transform: rotate(0deg);
  }

  .faq__item p {
    padding: 0 var(--space-5) var(--space-5);
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .faq {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
