---
import type { Lang } from '@/shared/i18n/config';
import type { Dictionary } from '@/shared/i18n/en';
import Icon from '@/shared/ui/Icon.astro';
import ContactForm from './ContactForm.vue';

interface Props {
  t: Dictionary['contact'];
  lang: Lang;
}

const { t, lang } = Astro.props;
---

<section id="contact" class="section section--navy contact" aria-labelledby="contact-title">
  <div class="container contact__grid">
    <div class="contact__copy" data-reveal>
      <p class="label" data-reveal-item>{t.label}</p>
      <h2 id="contact-title" data-reveal-item>{t.title}</h2>
      <p class="intro" data-reveal-item>{t.intro}</p>

      <div class="next" data-reveal-item>
        <h3>{t.nextTitle}</h3>
        <ol>
          {
            t.nextSteps.map((step, i) => (
              <li>
                <span aria-hidden="true">{i + 1}</span>
                {step}
              </li>
            ))
          }
        </ol>
      </div>

      <p class="email" data-reveal-item>
        {t.emailLabel}
        <a href={`mailto:${t.email}`}>
          <Icon name="mail" size={18} />
          {t.email}
        </a>
      </p>
    </div>

    <ContactForm client:visible t={t} lang={lang} />
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-7);
    align-items: start;
  }

  .contact__copy {
    display: grid;
    gap: var(--space-5);
  }

  .label {
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-teal);
  }

  h2 {
    color: var(--color-white);
    font-size: clamp(2rem, 1.6rem + 1.6vw, 2.75rem);
  }

  .intro {
    font-size: var(--text-lead);
    color: var(--color-on-navy-muted);
  }

  .next {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: var(--radius-panel);
  }

  .next h3 {
    font-size: 1.0625rem;
    color: var(--color-white);
  }

  .next ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    color: var(--color-on-navy-muted);
  }

  .next li {
    display: flex;
    gap: var(--space-3);
  }

  .next li span {
    flex: none;
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-teal);
    color: var(--color-navy);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-on-navy-muted);
  }

  .email a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    color: var(--color-white);
  }

  .email a:focus-visible {
    box-shadow: 0 0 0 3px var(--color-teal);
  }

  @media (max-width: 960px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
