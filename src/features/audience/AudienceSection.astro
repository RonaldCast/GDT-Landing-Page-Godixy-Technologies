---
import type { Dictionary } from '@/shared/i18n/en';
import Icon from '@/shared/ui/Icon.astro';
import SectionHeader from '@/shared/ui/SectionHeader.astro';
import type { IconName } from '@/shared/ui/icons';

interface Props {
  t: Dictionary['audience'];
}

const { t } = Astro.props;
const groupIcons: IconName[] = ['executive', 'engineer'];
---

<section id="audience" class="section" aria-labelledby="audience-title">
  <div class="container">
    <SectionHeader id="audience-title" label={t.label} title={t.title} intro={t.intro} />

    <div class="groups" data-reveal>
      {
        t.groups.map((group, i) => (
          <article class="group" data-reveal-item>
            <span class="group__icon">
              <Icon name={groupIcons[i] ?? 'check'} size={26} />
            </span>
            <h3>{group.title}</h3>
            <p class="group__text">{group.text}</p>
            <ul class="check-list">
              {group.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <h3 class="sizes__title" data-reveal>{t.sizesTitle}</h3>
    <ul class="sizes" data-reveal>
      {
        t.sizes.map((size, i) => (
          <li class="size" data-reveal-item>
            <span class="size__bars" aria-hidden="true">
              {[0, 1, 2].map((n) => (
                <span class:list={['bar', { 'bar--on': n <= i }]} />
              ))}
            </span>
            <div>
              <p class="size__title">{size.title}</p>
              <p class="size__text">{size.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .groups {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }

  .group {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding: var(--space-7) var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--color-white), var(--color-surface));
  }

  .group:nth-child(2) {
    background: linear-gradient(180deg, var(--color-white), var(--color-soft-teal));
  }

  .group__icon {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-panel);
    background: var(--color-navy);
    color: var(--color-teal);
  }

  .group__text {
    font-size: var(--text-lead);
    color: var(--color-muted);
  }

  .sizes__title {
    margin: var(--space-8) 0 var(--space-5);
  }

  .sizes {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .size {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
  }

  .size__bars {
    flex: none;
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 32px;
  }

  .bar {
    width: 8px;
    border-radius: 3px;
    background: var(--color-border);
  }

  .bar:nth-child(1) {
    height: 12px;
  }

  .bar:nth-child(2) {
    height: 22px;
  }

  .bar:nth-child(3) {
    height: 32px;
  }

  .bar--on {
    background: var(--color-teal);
  }

  .size__title {
    font-weight: 600;
  }

  .size__text {
    margin-top: var(--space-1);
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  @media (max-width: 860px) {
    .groups,
    .sizes {
      grid-template-columns: 1fr;
    }

    .group {
      padding: var(--space-6) var(--space-5);
    }
  }
</style>
