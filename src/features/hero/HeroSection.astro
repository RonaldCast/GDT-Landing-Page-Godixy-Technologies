---
import type { Dictionary } from '@/shared/i18n/en';
import Button from '@/shared/ui/Button.astro';
import Icon from '@/shared/ui/Icon.astro';
import HeroScene from './HeroScene.vue';

interface Props {
  t: Dictionary['hero'];
}

const { t } = Astro.props;
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero__backdrop" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__eyebrow enter enter--1">
        {t.eyebrow}
      </p>
      <h1 id="hero-title" class="enter enter--2" tabindex="-1">
        <span class="hero__title-full visually-hidden">{t.titleAccessible}</span>
        <span class="hero__title-rotator" aria-hidden="true">
          <span class="hero__prefix">{t.titlePrefix}</span>
          <span class="hero__phrases">
            {
              t.phrases.map((phrase, index) => (
                <span class="hero__phrase highlight" data-hero-phrase data-active={index === 0 ? '' : undefined}>
                  {phrase}
                </span>
              ))
            }
          </span>
        </span>
      </h1>
      <p class="hero__subtitle enter enter--3">
        {
          t.subtitle.map((part) =>
            part.emphasis ? <strong class="hero__emphasis">{part.text}</strong> : part.text,
          )
        }
      </p>
      <div class="hero__actions enter enter--4">
        <Button href="#contact" size="lg">
          {t.primaryCta}
          <Icon name="arrow" size={18} />
        </Button>
        <Button href="#services" variant="secondary" size="lg">{t.secondaryCta}</Button>
      </div>
    </div>
    <div class="hero__visual enter enter--3">
      <HeroScene client:idle label={t.sceneLabel} />
    </div>
  </div>
</section>

<script>
  import { startHeroPhrases } from './rotate-phrases';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) startHeroPhrases(hero);
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(48px, 7vw, 96px) clamp(64px, 8vw, 112px);
  }

  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 60% at 80% 30%, rgb(78 172 196 / 0.18), transparent 70%),
      radial-gradient(40% 50% at 10% 90%, rgb(226 244 246 / 0.9), transparent 70%),
      linear-gradient(var(--color-border) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px) 0 0 / 48px 48px;
    mask-image: linear-gradient(to bottom, black 55%, transparent);
    opacity: 0.7;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: var(--space-7);
  }

  .hero__copy {
    display: grid;
    gap: var(--space-5);
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    width: fit-content;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-white);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-teal-text);
  }

  h1 {
    font-size: var(--text-display);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .hero__title-rotator {
    display: block;
  }

  .hero__prefix {
    display: block;
  }

  .hero__phrases {
    display: grid;
    justify-items: start;
  }

  .hero__phrase {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.35em);
    transition:
      opacity 1200ms var(--ease-out),
      transform 1200ms var(--ease-out),
      visibility 1200ms;
  }

  .hero__phrase[data-active] {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .highlight {
    background: linear-gradient(90deg, var(--color-teal-text), var(--color-teal));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__subtitle {
    max-width: 580px;
    font-size: var(--text-lead);
    color: var(--color-muted);
  }

  .hero__emphasis {
    color: var(--color-navy);
    font-weight: 700;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  #hero-title:focus {
    outline: none;
    box-shadow: none;
  }

  .enter {
    animation: enter 800ms var(--ease-out) both;
  }

  :global(html[data-intro='playing']) .enter,
  :global(html[data-intro='exiting']) .enter {
    animation: none;
    opacity: 0;
    transform: translateY(24px);
  }

  .enter--2 {
    animation-delay: 80ms;
  }

  .enter--3 {
    animation-delay: 160ms;
  }

  .enter--4 {
    animation-delay: 240ms;
  }

  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__title-full.visually-hidden {
      position: static !important;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip: auto;
      white-space: normal;
    }

    .hero__title-rotator {
      display: none;
    }
  }

  @media (max-width: 960px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      order: -1;
      max-width: 380px;
      width: 100%;
      margin-inline: auto;
    }
  }
</style>
