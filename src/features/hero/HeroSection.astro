---
import type { Dictionary } from '@/shared/i18n/en';
import Button from '@/shared/ui/Button.astro';
import Icon from '@/shared/ui/Icon.astro';
import HeroScene from './HeroScene.vue';

interface Props {
  t: Dictionary['hero'];
}

const { t } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__backdrop" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__eyebrow enter enter--1">
        <span class="dot" aria-hidden="true"></span>
        {t.eyebrow}
      </p>
      <h1 id="hero-title" class="enter enter--2">
        {t.titleLead} <span class="highlight">{t.titleHighlight}</span>{' '}{t.titleTail}
      </h1>
      <p class="hero__subtitle enter enter--3">{t.subtitle}</p>
      <div class="hero__actions enter enter--4">
        <Button href="#contact" size="lg">
          {t.primaryCta}
          <Icon name="arrow" size={18} />
        </Button>
        <Button href="#services" variant="secondary" size="lg">{t.secondaryCta}</Button>
      </div>
      <ul class="hero__highlights enter enter--5">
        {
          t.highlights.map((item) => (
            <li>
              <Icon name="check" size={16} />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="hero__visual enter enter--3">
      <HeroScene client:idle label={t.sceneLabel} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(48px, 7vw, 96px) clamp(64px, 8vw, 112px);
  }

  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 60% at 80% 30%, rgb(78 172 196 / 0.18), transparent 70%),
      radial-gradient(40% 50% at 10% 90%, rgb(226 244 246 / 0.9), transparent 70%),
      linear-gradient(var(--color-border) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px) 0 0 / 48px 48px;
    mask-image: linear-gradient(to bottom, black 55%, transparent);
    opacity: 0.7;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: var(--space-7);
  }

  .hero__copy {
    display: grid;
    gap: var(--space-5);
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    width: fit-content;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-white);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-teal-text);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-teal);
    box-shadow: 0 0 0 4px rgb(78 172 196 / 0.2);
  }

  h1 {
    font-size: var(--text-display);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .highlight {
    background: linear-gradient(90deg, var(--color-teal-text), var(--color-teal));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__subtitle {
    max-width: 580px;
    font-size: var(--text-lead);
    color: var(--color-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__highlights {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .hero__highlights li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .hero__highlights :global(svg) {
    color: var(--color-teal-text);
  }

  .enter {
    animation: enter 800ms var(--ease-out) both;
  }

  .enter--2 {
    animation-delay: 80ms;
  }

  .enter--3 {
    animation-delay: 160ms;
  }

  .enter--4 {
    animation-delay: 240ms;
  }

  .enter--5 {
    animation-delay: 320ms;
  }

  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 960px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      order: -1;
      max-width: 380px;
      width: 100%;
      margin-inline: auto;
    }
  }
</style>
