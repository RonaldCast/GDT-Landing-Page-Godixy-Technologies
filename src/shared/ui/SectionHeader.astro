---
interface Props {
  id: string;
  label: string;
  title: string;
  intro?: string;
  align?: 'start' | 'center';
  tone?: 'light' | 'dark';
}

const { id, label, title, intro, align = 'start', tone = 'light' } = Astro.props;
---

<header class:list={['section-header', `section-header--${align}`, `section-header--${tone}`]} data-reveal>
  <p class="label" data-reveal-item>{label}</p>
  <h2 id={id} data-reveal-item>{title}</h2>
  {intro && <p class="intro" data-reveal-item>{intro}</p>}
</header>

<style>
  .section-header {
    display: grid;
    gap: var(--space-4);
    max-width: 760px;
    margin-bottom: var(--space-7);
  }

  .section-header--center {
    margin-inline: auto;
    text-align: center;
  }

  .label {
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-teal-text);
  }

  .intro {
    font-size: var(--text-lead);
    color: var(--color-muted);
  }

  .section-header--dark h2 {
    color: var(--color-white);
  }

  .section-header--dark .label {
    color: var(--color-teal);
  }

  .section-header--dark .intro {
    color: var(--color-on-navy-muted);
  }
</style>
